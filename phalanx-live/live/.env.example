# Copy this file to live/.env and fill in real values. .env is gitignored —
# never commit real credentials.

# --- MongoDB Atlas (the live data store — separate from TradeEdge's own DB) ---
# Get this from Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <password> with your database user's actual password. Same
# value as trade-edge-api's PHALANX_ATLAS_MONGODB_URI env var.
ATLAS_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
ATLAS_DB_NAME=phalanx_algo

# How many trading days of DAILY OHLCV history to keep per symbol (see README.md for why 500).
RETENTION_DAYS=500
